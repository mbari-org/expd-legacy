sub getSampleRow {

	($buildFor) = @_;
	
	#
	# Many variables needed in memroy for this to work.  Just keep them global for now.
	# They include: 
	#   $nSamples, $observationID, $tapeTimeCode, $stillImageURL, $sampleReference,
	#   $observer, $dateTime, $esecs, $strDateTime, $tapeTimeCode, $sampleID, $equipment,
	#   $varsLatitude, $varsLongitudem, $varsDepth, $varsDepthString,
	#   $editedLatitude, $editedLongitude, $editedDepth, $editedDepthString,
	#   $comment
	
	if ( $buildFor =~ /email/i ) {
		$disableText = "disabled";
	}
	else {
		$disableText = "";
	}

	$sampleRow = <<EOH;
<tr>
		  <!-- Sample $nSamples: ObservationID = $observationID (tapeTimeCode)-->
		  <td CLASS="checkboxCell"> 
