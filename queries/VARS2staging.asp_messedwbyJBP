sub getEditedNav {

	($rovName, $esecs) = @_;
	
	$view = $rovName;	# Must be Ventana, Tiburon, or DocRicketts 
	$view =~ s/\s+//;	# (without the space)
	
	##if ( $rovName eq 'Ventana' ) {
	##	 if ( $esecs < 977249672 ) {
	##	 	$eCrit = 5;			# 10 second interval before V1888 on 2000-12-19
	##	 }
	##	 else {
	##	 	$eCrit = 2;
	##	 }	
	##}
	
	#
	# Find out the sampling interval by first doing a 10 minute gap query
	#
	$eCrit = 300;
	$lowEsecs = $esecs - $eCrit;
	$highEsecs = $esecs + $eCrit;
	my $sqlEditedNav = "SELECT EpochSecs
                   FROM dbo.${view}CleanNavData
                   WHERE (EpochSecs BETWEEN $lowEsecs AND $highEsecs)";
                   
        $ConnExpd = CreateObject OLE "ADODB.Connection";
	$ConnExpd->{'Provider'} = "sqloledb";
	
	$ConnExpd->Open($dsnExpd);
	Win32::ASP::AddDeathHook( sub { $ConnExpd->Close } );	# In case asp dies do some cleanup

	if(keys %{$ConnExpd->Errors()}) {
	        $Errors = $ConnExpd->Errors();
	        print "<B>Error in opening connection to $dsnDive:</B>";
	        foreach $error (keys %$Errors) {
	                print $error->{Description}, "\n";
	        }
	        die "<BR>Cannot open EXPD database.";
	}
	
	Win32::ASP::DebugPrint("\nExecuting SQL: \n$sqlEditedNav");
	my $RSExpd = $ConnExpd->Execute($sqlEditedNav);
	if(!$RSExpd) {
	 	##$Response->Write("<BR>Empty Return Set: RSExpd. for <br>$sqlEditedNav <br>From dsn = $dsnExpd");
	}
	else {
		my $lastEs = 0;
		while( !$RSExpd->EOF ) {
			my $es = $RSExpd->Fields('EpochSecs')->Value;
			$RSExpd->MoveNext;
			$diffEs = $es - $lastEs if $lastEs;
			$lastEs = $es;
		}
	}
	
	$eCrit = $diffEs / 2;
	
	$lowEsecs = $esecs - $eCrit;
	$highEsecs = $esecs + $eCrit;
        
        my $sqlEditedNav = "SELECT Latitude, Longitude, Pressure, Depth
                   FROM dbo.${view}CleanNavData
                   WHERE (EpochSecs BETWEEN $lowEsecs AND $highEsecs)";
                   
        $ConnExpd = CreateObject OLE "ADODB.Connection";
	$ConnExpd->{'Provider'} = "sqloledb";
	
	$ConnExpd->Open($dsnExpd);
	Win32::ASP::AddDeathHook( sub { $ConnExpd->Close } );	# In case asp dies do some cleanup

	if(keys %{$ConnExpd->Errors()}) {
	        $Errors = $ConnExpd->Errors();
	        print "<B>Error in opening connection to $dsnDive:</B>";
	        foreach $error (keys %$Errors) {
	                print $error->{Description}, "\n";
	        }
	        die "<BR>Cannot open EXPD database.";
	}
	
	Win32::ASP::DebugPrint("\nExecuting SQL: \n$sqlEditedNav");
	my $RSExpd = $ConnExpd->Execute($sqlEditedNav);
	$editedLatitude = '';
	$editedLongitude= '';
	$editedDepth = '';
	if(!$RSExpd) {
	 	##$Response->Write("<BR>Empty Return Set: RSExpd. for <br>$sqlEditedNav <br>From dsn = $dsnExpd");
	}
	else {
		$editedLatitude = sprintf("%.6f", $RSExpd->Fields('Latitude')->Value) if $RSExpd->Fields('Latitude')->Value;
		$editedLongitude = sprintf("%.6f", $RSExpd->Fields('Longitude')->Value) if $RSExpd->Fields('Longitude')->Value;
		$editedDepth = sprintf("%.1f", $RSExpd->Fields('Depth')->Value) if $RSExpd->Fields('Depth')->Value;
	}
	$RSExpd->Close();
	$ConnExpd->Close();
        
        return ($editedLatitude, $editedLongitude, $editedDepth);

} # End getEditedNav()


