sub getImageTitleTime {

	($url) = @_;
	
	$url =~ s/.jpg$/.comment/i;
	
	$text = '';
	Win32::ASP::DebugPrint("\nGetting lines from: \n$url");
	foreach ( split("\n", get($url)) ) {
		Win32::ASP::DebugPrint("\nline= \n$_");
		if ( /EPOCHsecs = (\d+)/ ) {		# 
			$imageEsecs = $1;
		}
		if ( /UTCTime/ ) {
			$text = $_;
			last;
		}
	}
	
	return ($text, $imageEsecs);
	
}

