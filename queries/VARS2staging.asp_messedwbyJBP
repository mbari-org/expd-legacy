sub getSampleID {

	local ($sampleReference, $tapeTimeCode) = @_;

	return '' unless $sampleReference;
	
	#
	# Open Samples Database
	#
	$ConnSamples = CreateObject OLE "ADODB.Connection";
	$ConnSamples->{'Provider'} = "sqloledb";
	
	$ConnSamples->Open($dsnSamples);
	Win32::ASP::AddDeathHook( sub { $ConnSamples->Close } );	# In case asp dies do some cleanup
	
	if(keys %{$ConnSamples->Errors()}) {
	        $Errors = $ConnSamples->Errors();
	        print "<B>Error in opening connection to $dsnDive:</B>";
	        foreach $error (keys %$Errors) {
	                print $error->{Description}, "\n";
	        }
	        die "<BR>Cannot open EXPD database.";
	}
		
	#
	# Check id Sample-reference is already in the Samples database
	#
	$sqlSample = " SELECT SampleID FROM vwCollSamplePerson WHERE SampleRefName = '$sampleReference' AND TapeTimeCode = '$tapeTimeCode'";
		
	
	Win32::ASP::DebugPrint("\nExecuting SQL: \n$sqlSample");
	my $RSsample = $ConnSamples->Execute($sqlSample);
	$sampleID = '';
	if(!$RSsample) {
	 	$Response->Write("<BR>Empty Return Set: RSsample. for <br>$sqlSample <br>From dsn = $dsnSamples");
	}
	else {
		$sampleID = $RSsample->Fields('SampleID')->Value;
	}
	$RSsample->Close();
	
	$ConnSamples->Close();
	
	return $sampleID;

} # End getSampleID()

