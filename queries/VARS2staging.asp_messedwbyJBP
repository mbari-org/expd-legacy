	# Here document that can be called from buildWebPage() or emailWebPage().
	#

	if ( $buildFor =~ /email/i ) {
		$disableText = "disabled";
	}
	else {
		$disableText = "";
	}
	
	$webPageTop = <<EOH;
<!doctype html public "-//w3c//dtd html 4.01 transitional//en">

<html>

<head>
<title>Samples from VARS to be loaded into the Samples database</title>
<link rel="stylesheet" type="text/css" href="$webRoot/expd/styles/expd.css">
<script language="JavaScript" type="text/javascript">
function checkAll() {
	var value = document.processSamples.checkall.checked;
	var checks = document.processSamples.elements['LOAD'];
	
	if (checks.length) {
		var i;
		for (i = 0; i < checks.length; i++) {
			checks[i].checked = value;
		}
	} else {
		checks.checked = value;
	}
}

function ValidateTop() {

	theForm = document.processSamples;
	
	if(CheckTopFields(theForm) == false) return false;

	return true;
}

function ValidateTopAndEmail() {

	theForm = document.processSamples;
	
	if(CheckTopFields(theForm) == false) return false;

	if(CheckEmail(theForm) == false) return false;

	return true;
}

function ValidateTopAndPassword() {

	theForm = document.processSamples;
	
	if(CheckTopFields(theForm) == false) return false;

	if(CheckPassword(theForm) == false) return false;

	return true;
}

function CheckTopFields(theForm) {

	if (theForm.ChiefScientist.value == "") {
		alert("Please enter Chief Scientist who collected these samples.");
		theForm.ChiefScientist.focus();
		return (false);
	}
	if (theForm.Collector.value == "") {
		alert("Please enter PI for whom these samples were collected.");
		theForm.Collector.focus();
		return (false);
	}
	if (theForm.WaypointName.value == "") {
		alert("Please enter waypoint name where these samples were collected.");
		theForm.WaypointName.focus();
		return (false);
	}

	return (true);
}

function CheckEmail(theForm) {
	if (theForm.emailAddress.value == "" ) {
		alert("Please enter your email address.");
		theForm.emailAddress.focus();
		return (false);
	}
	
	return (true);
}

function CheckPassword(theForm) {
	if (theForm.Password.value == "" ) {
		alert("Please enter the password.");
		theForm.Password.focus();
		return (false);
	}
	
	return (true);
}
</script>

