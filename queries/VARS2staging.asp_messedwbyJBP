sub buildWebPage {
#
# Open database connections to VARS
#
$Application->Lock();
$Conn = CreateObject OLE "ADODB.Connection";
$Conn->{'Provider'} = "sqloledb";

$Conn->Open($dsn);

Win32::ASP::AddDeathHook( sub { $Conn->Close } );	# In case asp dies do some cleanup

if(keys %{$Conn->Errors()}) {
        $Errors = $Conn->Errors();
        print "<B>Error in opening connection to $dsn:</B>";
        foreach $error (keys %$Errors) {
                print $error->{Description}, "\n";
        }
        die "<BR>Cannot open VARS database.";
}


$chiefScientist = GetFormValue("ChiefScientist");
$collector = GetFormValue('Collector');
$waypointName = GetFormValue('WaypointName');
		
#
# Web page top from reusable subroutine
#
$Response->write(getWebPageTop());

#
# Query for sampled-by annotations from VARS Annotations view
#
if ( $diveNumber ) {
	$sql = "
SELECT DISTINCT 
      CONVERT(varchar(22), RecordedDate, 120) as DateTime24, DateDiff(ss, '01/01/70', RecordedDate) AS Esecs, TapeTimeCode, ConceptName, Image, 
      Depth, Latitude, Longitude, CameraDirection, ISNULL(Observer, '') AS Observer, 
      AnnotationMode, ObservationID_FK
FROM  dbo.Annotations
WHERE (RovName = '$varsPlatformName') AND (DiveNumber = $diveNumber) AND (LinkName = 'sampled-by')
ORDER BY TapeTimeCode, DateTime24
";
}
else {
	$sql = "
SELECT DISTINCT 
      CONVERT(varchar(22), RecordedDate, 120) as DateTime24, DateDiff(ss, '01/01/70', RecordedDate) AS Esecs, TapeTimeCode, ConceptName, Image, 
      Depth, Latitude, Longitude, CameraDirection, ISNULL(Observer, '') AS Observer, 
      AnnotationMode, ObservationID_FK
FROM  dbo.Annotations
WHERE (RovName = '$varsPlatformName') AND (RecordedDate BETWEEN '$SCollDTG' AND '$ECollDTG') AND (LinkName = 'sampled-by')
ORDER BY TapeTimeCode, DateTime24
";
}

#
# Execute SQL and get Sample records from VARS
#
Win32::ASP::DebugPrint("\nExecuting SQL: \n$sql");
my $RS = $Conn->Execute($sql);
$nSamples = 0;
if(!$RS) {
 	 $Response->Write("<BR>Empty Return Set: RS. for <br>$sql <br>From dsn = $dsn");
}
else {
	
	while ( !$RS->EOF ) { 
		$stillImageURL = $RS->Fields('Image')->Value;
		$observationID = $RS->Fields('ObservationID_FK')->Value;
		$dateTime = $RS->Fields('DateTime24')->Value;
		$strDateTime = $dateTime . " GMT" ;
		$strDateTime =~ s/\s+/&nbsp;/g;	# Fill with non breaking spaces so that text does not wrap in table cell
		$strDateTime =~ s/-/\//g;	# Replace dashes with slashes that don't break on lines
		$esecs = $RS->Fields('Esecs')->Value;
		$tapeTimeCode = $RS->Fields('TapeTimeCode')->Value;
		$conceptName = $RS->Fields('ConceptName')->Value;
		$observer = $RS->Fields('Observer')->Value;
		
		#
		# Check for check boxes and fields passed in from emailed "form" link
		#
		$comment = GetFormValue("${tapeTimeCode}_c");
		$load = GetFormValue("${tapeTimeCode}_l");
		
		#
		# Ancillary data from database, will result in '' aboard ship - need to read from files
		#
		$varsLatitude = ($RS->Fields('Latitude')->Value) ? sprintf("%.6f", $RS->Fields('Latitude')->Value) : '';
		$varsLongitude = ($RS->Fields('Longitude')->Value) ? sprintf("%.6f", $RS->Fields('Longitude')->Value) : '';
		$varsDepth = ($RS->Fields('Depth')->Value) ? sprintf("%.1f", $RS->Fields('Depth')->Value) : '';
		$varsDepthString = $varsDepth . " m" if $varsDepth;
		
		$nSamples++;
		
		$sqlDetail = $sqlDetailBeg . $observationID;
		Win32::ASP::DebugPrint("\nExecuting SQL: \n$sqlDetail");

		my $RSdetail = $Conn->Execute($sqlDetail);
		$sampleReference = '';
		$equipment = '';
		$varsComment = '';
		if(!$RSdetail) {
 	 		$Response->Write("<BR>Empty Return Set: RSdetail. for <br>$sql <br>From dsn = $dsn");
		}
		else {
			while ( !$RSdetail->EOF ) {
				Win32::ASP::DebugPrint("\nLinkName = " . $RSdetail->Fields('LinkName')->Value . "\n");
				
				if ( $RSdetail->Fields('LinkName')->Value eq 'sample-reference') {
					$sampleReference = $RSdetail->Fields('LinkValue')->Value;
				}
				elsif ( $RSdetail->Fields('LinkName')->Value eq 'identity-reference') {
					$identityReference = $RSdetail->Fields('LinkValue')->Value;
				}
				elsif ( $RSdetail->Fields('LinkName')->Value eq 'sampled-by') {
					$linkValue = $RSdetail->Fields('LinkValue')->Value;
					$toConcept = $RSdetail->Fields('ToConcept')->Value;
				}
				elsif ( $RSdetail->Fields('LinkName')->Value =~ /comment/) {
					$varsComment = $RSdetail->Fields('LinkValue')->Value;
				}
				$RSdetail->MoveNext;
			}
			$sampleReference = ($sampleReference) ? $sampleReference : $identityReference;
			Win32::ASP::DebugPrint("\nlinkValue = $linkValue, toConcept = $toConcept\n");
			if ($toConcept eq 'equipment') {
				$equipment = $linkValue;		# The old pre-VARS way of handing equipment
			}
			else {
				$equipment = $toConcept;
			}
				
		}
		$RSdetail->Close();
		
		if ($thishost =~ /typhoon/i) {
			#
			# Check if this sample is already in the Samples Database
			#
			$sampleID = getSampleID($sampleReference, $tapeTimeCode);
			
			#
			# Query Expedition database view for edited (clean) nav data
			#
			($editedLatitude, $editedLongitude, $editedDepth) = getEditedNav($varsPlatformName, $esecs);
			$editedDepthString = $editedDepth . " m" if $editedDepth;
			
			#
			# Assign navigation, use edited if it exists
			#
			$latitude = ($editedLatitude) ? $editedLatitude : $varsLatitude;
			$longitude = ($editedLongitude) ? $editedLongitude : $varsLongitude;
			$depth = ($editedDepth) ? $editedDepth : $varsDepth;
		}
		
		#
		# Build hidden field that gets passed to loadColl.asp
		# e.g. <INPUT TYPE="hidden" NAME="SAMPLES" VALUE="|http://mww.mbari.org/Ventana/stills/2001/096/00_25_32_07.jpg|02:20:06:18|986584116|04/06/01 07:08:36 PM||ophiurida|manipulator|L1956A6|| 36.783703|-121.959512|556.8|">
		#
		my $null = '';
		$SampPipes = "$null|$stillImageURL|$tapeTimeCode|$esecs|";
		$SampPipes .= "$dateTime|$observer|$conceptName|";
		$SampPipes .= "$equipment|$sampleReference|$null|";
		$SampPipes .= "$latitude|$longitude|$depth|$nSamples|$null";	
		
		#
		# Need to pass vars and edited nav data for it to appear in email form
		#
		$VarsNavPipes = "$varsLatitude|$varsLongitude|$varsDepth";
		$EditedNavPipes = "$editedLatitude|$editedLongitude|$editedDepth";
		
		#
		# Table row HTML
		#
		$Response->write(getSampleRow());
		
		$RS->MoveNext;
		
	} # End while ( !$RS->EOF )
} # End if(!$RS)

$RS->Close();
$Conn->Close();
$Application->Unlock();

#
# Output end of web page
#
$Response->write(getWebPageBottom());

} #End buildWebPage()


